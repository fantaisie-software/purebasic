Procedure ButtonEvent()
  Filename$ = OpenFileRequester("", #PB_Requester_MultiSelection)
  
  While Filename$
    Debug Filename$
    Filename$ = NextSelectedFilename()
  Wend
EndProcedure

If OpenWindow(0, 100, 100, 200, 45, "Requester")
  ButtonGadget(0, 10, 10, 180, 25, "Open local file(s)...")
  BindGadgetEvent(0, @ButtonEvent())
EndIf
