Procedure ChooseFileEvent()
  Filename$ = OpenFileRequester("text/plain")
  If Filename$
    If ReadFile(0, Filename$, 0, #PB_LocalFile)
       
      ; Read the first 10 lines
      ;
      While Eof(0) = 0 And NbLine < 10
        Debug ReadString(0)            
        NbLine+1
      Wend
      
      CloseFile(0)
    EndIf
  EndIf
EndProcedure

OpenWindow(0, 0, 0, 300, 50, "Read file example", #PB_Window_ScreenCentered)
ButtonGadget(0, 10, 10, 280, 30, "Choose a text file...")

BindGadgetEvent(0, @ChooseFileEvent())
